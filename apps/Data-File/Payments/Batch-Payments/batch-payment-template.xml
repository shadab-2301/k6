<?xml version="1.0" encoding="UTF-8"?>
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:pain.001.001.09">
  <CstmrCdtTrfInitn>
    <GrpHdr>
      <MsgId>{{MSG_ID}}</MsgId>
      <CreDtTm>{{CREATION_DATETIME}}</CreDtTm>
      <NbOfTxs>{{NB_OF_TXS}}</NbOfTxs>
      <CtrlSum>{{CTRL_SUM}}</CtrlSum>
      <InitgPty>
        <Id>
          <OrgId>
            <Othr>
              <Id>{{COMPANY_ID}}</Id>
              <SchmeNm>
                <Prtry>COMPANYID</Prtry>
              </SchmeNm>
            </Othr>
            <Othr>
              <Id>{{USER_ID}}</Id>
              <SchmeNm>
                <Prtry>USERID</Prtry>
              </SchmeNm>
            </Othr>
            <Othr>
              <Id>{{CHANNEL}}</Id>
              <SchmeNm>
                <Prtry>CHANNEL</Prtry>
              </SchmeNm>
            </Othr>
          </OrgId>
        </Id>
      </InitgPty>
      <SplmtryData>
        <PlcAndNm>FileMetadata</PlcAndNm>
        <Envlp>
          <FileType>CSV</FileType>
          <TemplateType>Investec</TemplateType>
          <TemplateVersion>Investec_csv2</TemplateVersion>
          <FileName>{{FILE_NAME}}</FileName>
          <FileDesc>{{FILE_DESC}}</FileDesc>
          <OrigFileName>{{ORIG_FILE_NAME}}</OrigFileName>
          <SingleDebit>{{SINGLE_DEBIT}}</SingleDebit>
          <Encrypted>false</Encrypted>
          <AutoInitiate>false</AutoInitiate>
          <HashCode>{{HASH_CODE}}</HashCode>
          <FileSizeBytes>{{FILE_SIZE_BYTES}}</FileSizeBytes>
          <AllowDuplicate>{{ALLOW_DUPLICATE}}</AllowDuplicate>
          <InsufficientFundsCheck>false</InsufficientFundsCheck>
        </Envlp>
      </SplmtryData>
    </GrpHdr>

    <!-- Transaction 1 -->
    <PmtInf>
      <PmtInfId>{{PMT_INF_ID_1}}</PmtInfId>
      <PmtMtd>TRF</PmtMtd>
      <NbOfTxs>1</NbOfTxs>
      <CtrlSum>{{CTRL_SUM_1}}</CtrlSum>
      <PmtTpInf>
        <InstrPrty>NORM</InstrPrty>
        <LclInstrm>
          <Prtry>{{PAYMENT_TYPE}}</Prtry>
        </LclInstrm>
      </PmtTpInf>
      <Dbtr>
        <Nm>{{DEBTOR_NAME}}</Nm>
        <PstlAdr>
          <StrtNm>{{DEBTOR_STREET}}</StrtNm>
          <PstCd>{{DEBTOR_POSTAL_CODE}}</PstCd>
          <TwnNm>{{DEBTOR_TOWN}}</TwnNm>
          <CtrySubDvsn>{{DEBTOR_REGION}}</CtrySubDvsn>
          <Ctry>{{DEBTOR_COUNTRY}}</Ctry>
        </PstlAdr>
      </Dbtr>
      <ReqdExctnDt>
        <Dt>{{PAYMENT_DATE}}</Dt>
      </ReqdExctnDt>
      <DbtrAcct>
        <Id>
          <Othr>
            <Id>{{DEBIT_ACCOUNT}}</Id>
          </Othr>
        </Id>
        <Ccy>{{CURRENCY}}</Ccy>
      </DbtrAcct>
      <CdtTrfTxInf>
        <PmtId>
          <InstrId>{{INSTR_ID_1}}</InstrId>
          <EndToEndId>{{END_TO_END_ID_1}}</EndToEndId>
        </PmtId>
        <Amt>
          <InstdAmt Ccy="{{CURRENCY}}">{{AMOUNT_1}}</InstdAmt>
        </Amt>
        <CdtrAcct>
          <Id>
            <Othr>
              <Id>{{CREDIT_ACCOUNT_1}}</Id>
              <SchmeNm>
                <Prtry>{{CREDIT_ACCOUNT_SCHEME_1}}</Prtry>
              </SchmeNm>
            </Othr>
          </Id>
        </CdtrAcct>
        <CdtrAgt>
          <FinInstnId>
            <ClrSysMmbId>
              <MmbId>{{CREDITOR_MEMBER_ID_1}}</MmbId>
            </ClrSysMmbId>
          </FinInstnId>
        </CdtrAgt>
        <RmtInf>
          <Ustrd>{{REMITTANCE_INFO_1}}</Ustrd>
        </RmtInf>
        <SplmtryData>
          <PlcAndNm>BeneficiaryNotification</PlcAndNm>
          <Envlp>
            <Ntfy>{{NOTIFY_1}}</Ntfy>
            <Email>{{EMAIL_1}}</Email>
          </Envlp>
        </SplmtryData>
      </CdtTrfTxInf>
    </PmtInf>

    <!-- Transaction 2 -->
    <PmtInf>
      <PmtInfId>{{PMT_INF_ID_2}}</PmtInfId>
      <PmtMtd>TRF</PmtMtd>
      <NbOfTxs>1</NbOfTxs>
      <CtrlSum>{{CTRL_SUM_2}}</CtrlSum>
      <PmtTpInf>
        <InstrPrty>NORM</InstrPrty>
        <LclInstrm>
          <Prtry>{{PAYMENT_TYPE}}</Prtry>
        </LclInstrm>
      </PmtTpInf>
      <Dbtr>
        <Nm>{{DEBTOR_NAME}}</Nm>
        <PstlAdr>
          <StrtNm>{{DEBTOR_STREET}}</StrtNm>
          <PstCd>{{DEBTOR_POSTAL_CODE}}</PstCd>
          <TwnNm>{{DEBTOR_TOWN}}</TwnNm>
          <CtrySubDvsn>{{DEBTOR_REGION}}</CtrySubDvsn>
          <Ctry>{{DEBTOR_COUNTRY}}</Ctry>
        </PstlAdr>
      </Dbtr>
      <ReqdExctnDt>
        <Dt>{{PAYMENT_DATE}}</Dt>
      </ReqdExctnDt>
      <DbtrAcct>
        <Id>
          <Othr>
            <Id>{{DEBIT_ACCOUNT}}</Id>
          </Othr>
        </Id>
        <Ccy>{{CURRENCY}}</Ccy>
      </DbtrAcct>
      <CdtTrfTxInf>
        <PmtId>
          <InstrId>{{INSTR_ID_2}}</InstrId>
          <EndToEndId>{{END_TO_END_ID_2}}</EndToEndId>
        </PmtId>
        <Amt>
          <InstdAmt Ccy="{{CURRENCY}}">{{AMOUNT_2}}</InstdAmt>
        </Amt>
        <CdtrAcct>
          <Id>
            <Othr>
              <Id>{{CREDIT_ACCOUNT_2}}</Id>
              <SchmeNm>
                <Prtry>{{CREDIT_ACCOUNT_SCHEME_2}}</Prtry>
              </SchmeNm>
            </Othr>
          </Id>
        </CdtrAcct>
        <CdtrAgt>
          <FinInstnId>
            <ClrSysMmbId>
              <MmbId>{{CREDITOR_MEMBER_ID_2}}</MmbId>
            </ClrSysMmbId>
          </FinInstnId>
        </CdtrAgt>
        <RmtInf>
          <Ustrd>{{REMITTANCE_INFO_2}}</Ustrd>
        </RmtInf>
        <SplmtryData>
          <PlcAndNm>BeneficiaryNotification</PlcAndNm>
          <Envlp>
            <Ntfy>{{NOTIFY_2}}</Ntfy>
            <Email>{{EMAIL_2}}</Email>
          </Envlp>
        </SplmtryData>
      </CdtTrfTxInf>
    </PmtInf>
  </CstmrCdtTrfInitn>
</Document>

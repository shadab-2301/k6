# Microsoft Teams "Send webhook alerts to a channel" Workflow URL.
# Used by apps/src/utilities/utilities/teams-notification.ts to post the API automation suite summary.
TEAMS_WEBHOOK_URL=https://default6d6a11bc469a48dfa548d3f353ac1b.e8.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/89b532af1b7847d0a6a7ffaede7b6f0a/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=JbaxRmg98WYjjeD_DEh_rXRzf-0QhCRWgq_-PWEjXe4

# Toggle whether a Teams notification is sent when >=1 scenario fails (default true if unset).
TEAMS_NOTIFY_ON_FAIL=true

# Toggle whether a Teams notification is sent when all scenarios pass (default false if unset).
TEAMS_NOTIFY_ON_PASS=false

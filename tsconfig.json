{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "config/**/*.ts", "helper/**/*.ts", "tests/**/*.ts", "utils/**/*.js"]
}
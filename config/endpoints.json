{
  "dev": {
    "baseUrl": "http://localhost:3000",
    "endpoints": [
      {
        "name": "Get All Posts",
        "method": "GET",
        "path": "/posts",
        "expectedStatus": 200,
        "thresholds": {
          "duration": 500,
          "errorRate": 0.1
        }
      },
      {
        "name": "Get Single Post",
        "method": "GET",
        "path": "/posts/1",
        "expectedStatus": 200,
        "thresholds": {
          "duration": 400,
          "errorRate": 0.05
        }
      },
      {
        "name": "Create Post",
        "method": "POST",
        "path": "/posts",
        "expectedStatus": 201,
        "payload": {
          "title": "Test Post",
          "body": "This is a test post",
          "userId": 1
        },
        "thresholds": {
          "duration": 600,
          "errorRate": 0.1
        }
      },
      {
        "name": "Update Post",
        "method": "PUT",
        "path": "/posts/1",
        "expectedStatus": 200,
        "payload": {
          "id": 1,
          "title": "Updated Post",
          "body": "Updated test post",
          "userId": 1
        },
        "thresholds": {
          "duration": 500,
          "errorRate": 0.1
        }
      },
      {
        "name": "Delete Post",
        "method": "DELETE",
        "path": "/posts/1",
        "expectedStatus": 200,
        "thresholds": {
          "duration": 400,
          "errorRate": 0.1
        }
      }
    ]
  },
